{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "node-gtk": ["./node_modules/.node-gtk-types/node-gtk.d.ts"],
      "@app/*": ["./packages/client/app/*"],
      "@pages/*": ["./packages/client/pages/*"],
      "@modules/*": ["./packages/client/modules/*"],
      "@common/*": ["./packages/client/common/*"]
    }
  },
  "include": [
    "packages/client",
    "packages/server",
    "packages/native",
    "packages/core",
    "packages/cli",
    "node_modules/.node-gtk-types/node-gtk.d.ts",
    "packages/hub"
  ]
}
