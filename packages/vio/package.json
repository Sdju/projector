{
  "name": "vio",
  "version": "0.3.3",
  "description": "Vue custom renderer for native GTK4 applications on Node.js",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./compiler": {
      "types": "./dist/compiler.d.mts",
      "import": "./dist/compiler.mjs"
    },
    "./register": "./dist/register.mjs"
  },
  "scripts": {
    "build": "node-gtk generate-types Gtk-4.0 --no-docs && tsdown",
    "test": "vp run build && node tests/renderer.test.mjs && node tests/compiler.test.mjs",
    "demo": "node --import vio/register examples/counter/app/entry.ts",
    "gtk:types": "node-gtk generate-types Gtk-4.0 --no-docs",
    "test:gtk": "node --import vio/register tests/gtk.test.mjs"
  },
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/runtime-core": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsdown": "^0.21.0",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "node-gtk": "^4.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
