{
  "roots": {
    "src": {
      "kind": "frontend",
      "dependencies": ["core"],
      "transitModules": ["agents-integration"]
    },
    "server": {
      "kind": "backend",
      "dependencies": ["core"],
      "transitModules": ["agents-integration"]
    },
    "native": {
      "kind": "frontend",
      "dependencies": ["core"]
    },
    "core": {
      "kind": "library",
      "dependencies": [],
      "transitModules": ["agents-integration"]
    },
    "cli": {
      "kind": "library",
      "dependencies": ["core"]
    },
    "packages/vio/src": {
      "kind": "library",
      "dependencies": []
    },
    "packages/vio/examples/counter": {
      "kind": "frontend",
      "dependencies": []
    }
  },
  "aliases": {
    "@app": "src/app",
    "@pages": "src/pages",
    "@modules": "src/modules",
    "@common": "src/common",
    "@core": "core/modules"
  },
  "largeFiles": {
    "files": {},
    "thresholds": {
      "default": 400,
      ".vue": 500
    }
  }
}
