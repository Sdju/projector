{
  "name": "projector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run architecture && vp run gtk:types && vp run vio:build && vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "gtk:types": "node-gtk generate-types Gtk-4.0 GdkX11-4.0 GioUnix-2.0 --no-docs",
    "test": "vp run architecture && vp run test:architecture && vp run vio:test && node --test tests/launcher.test.mjs tests/integrations.test.mjs tests/terminal.test.mjs tests/terminal-input.test.mjs tests/workspace.test.mjs tests/file-icons.test.mjs tests/restart.test.mjs && node tests/launcher-model.test.mjs",
    "vio:build": "vp run --filter vio build",
    "vio:test": "vp run --filter vio test",
    "vio:demo": "vp run --filter vio demo",
    "vio:gtk-test": "vp run --filter vio test:gtk",
    "test:file-icons": "node --test tests/file-icons.test.mjs",
    "architecture": "node scripts/check-architecture.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "check": "vp run test && vp run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.54",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.112",
    "dbus-next": "0.10.2",
    "monaco-editor": "^0.57.0",
    "node-gtk": "4.1.1",
    "node-pty": "^1.1.0",
    "vio": "workspace:*",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/simple-icons": "^1.2.98",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  }
}
