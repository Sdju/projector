{
  "name": "projector",
  "version": "0.4.1",
  "private": true,
  "description": "Local Linux application and project launcher with a GTK palette, web workspace and terminals",
  "homepage": "https://github.com/Sdju/projector#readme",
  "bugs": {
    "url": "https://github.com/Sdju/projector/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sdju/projector.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run architecture && vp run gtk:types && vp run vio:build && vue-tsc --noEmit && vp build",
    "preview": "node server/app/standalone.ts",
    "gtk:types": "node scripts/gtk-types.mjs",
    "test": "vp run architecture && vp run vio:test && vp test run",
    "vio:build": "vp run --filter vio build",
    "vio:test": "vp run --filter vio test",
    "vio:demo": "vp run --filter vio demo",
    "vio:gtk-test": "vp run --filter vio test:gtk",
    "architecture": "node scripts/check-feod.mjs",
    "test:architecture": "vp test run tests/architecture.test.mjs",
    "test:docker": "vp test run tests/docker.test.mjs",
    "test:file-icons": "vp test run tests/file-icons.test.mjs",
    "test:virtual-list": "vp test run tests/virtual-list.test.mjs",
    "test:tree": "vp test run tests/tree-page.test.mjs tests/tree-pagination.test.mjs",
    "test:live": "PROJECTOR_TEST_DOCKER=1 PROJECTOR_TEST_DEVCONTAINER=1 vp test run --no-file-parallelism tests/environment-live.test.mjs tests/reconcile.test.mjs tests/devcontainer-live.test.mjs tests/sigkill-live.test.mjs",
    "check": "vp run test && vp run test:docker && vp run build",
    "prepare": "vp hooks enable"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.54",
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@devcontainers/cli": "^0.89.0",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.112",
    "dbus-next": "0.10.2",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "node-gtk": "4.1.1",
    "node-pty": "^1.1.0",
    "vio": "workspace:*",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/devicon": "^1.2.68",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/simple-icons": "^1.2.98",
    "@o-feod/eslint-structure-plugin": "0.1.3",
    "@o-feod/oxlint-structure-plugin": "0.1.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "node-gyp": "^13.0.2",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
