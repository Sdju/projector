{
  "name": "projector",
  "version": "0.11.0",
  "private": true,
  "description": "Local application and project launcher with a GTK palette, web workspace and terminals",
  "homepage": "https://github.com/Sdju/projector#readme",
  "bugs": {
    "url": "https://github.com/Sdju/projector/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sdju/projector.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run build:prepare && vp run --cache build:app",
    "preview": "node packages/server/app/standalone.ts",
    "gtk:types": "node scripts/gtk-types.mjs",
    "types": "vue-tsc --noEmit",
    "build:prepare": "vp run --cache architecture && vp run gtk:types && vp run --cache types",
    "build:app": "vp build",
    "test": "vp run --cache architecture && vp test run",
    "architecture": "node scripts/check-feod.mjs",
    "test:evals": "vp test run --config vite.evals.config.ts",
    "eval:judge": "node evals/judge.mjs",
    "eval:widgets:opencode": "node evals/run-widgets.mjs",
    "test:docker": "vp test run tests/docker.test.mjs",
    "test:file-icons": "vp test run tests/file-icons.test.mjs",
    "test:virtual-list": "vp test run tests/virtual-list.test.mjs",
    "test:tree": "vp test run tests/tree-page.test.mjs tests/tree-pagination.test.mjs",
    "test:live": "PROJECTOR_TEST_DOCKER=1 PROJECTOR_TEST_DEVCONTAINER=1 vp test run --no-file-parallelism tests/environment-live.test.mjs tests/reconcile.test.mjs tests/devcontainer-live.test.mjs tests/sigkill-live.test.mjs",
    "check": "vp run build:prepare && vp test run && vp run --cache build:app",
    "prepare": "node scripts/ensure-vite-plus-core.mjs && node packages/cli/app/fix-node-pty.ts && node packages/native/scripts/build.mjs && vp hooks enable",
    "test:gtk": "node --import @zede/vio/register tests/native-palette.gtk.mjs",
    "bench:chat": "node scripts/bench-chat/run.mjs",
    "build:distribution": "vp run build && node packages/ide/scripts/build.mjs && node packages/native/scripts/build.mjs && node packages/hub/scripts/build.mjs && node scripts/distribution/verify.mjs",
    "hub": "node packages/hub/app/main.ts"
  },
  "devDependencies": {
    "@ai-projector/native": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@codemirror/view": "catalog:",
    "@iconify-json/devicon": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@o-feod/eslint-structure-plugin": "catalog:",
    "@o-feod/oxlint-structure-plugin": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@xterm/addon-serialize": "catalog:",
    "@xterm/headless": "catalog:",
    "@xterm/xterm": "catalog:",
    "@zede/vio": "catalog:",
    "ai": "catalog:",
    "node-gtk": "catalog:",
    "node-gyp": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
