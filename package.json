{
  "name": "projector",
  "version": "0.9.0",
  "private": true,
  "description": "Local application and project launcher with a GTK palette, web workspace and terminals",
  "homepage": "https://github.com/Sdju/projector#readme",
  "bugs": {
    "url": "https://github.com/Sdju/projector/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sdju/projector.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run build:prepare && vp run --cache build:app",
    "preview": "node packages/server/app/standalone.ts",
    "gtk:types": "node scripts/gtk-types.mjs",
    "types": "vue-tsc --noEmit",
    "build:prepare": "vp run --cache architecture && vp run gtk:types && vp run --cache types",
    "build:app": "vp build",
    "test": "vp run --cache architecture && vp test run",
    "architecture": "node scripts/check-feod.mjs",
    "test:evals": "vp test run --config vite.evals.config.ts",
    "eval:judge": "node evals/judge.mjs",
    "test:docker": "vp test run tests/docker.test.mjs",
    "test:file-icons": "vp test run tests/file-icons.test.mjs",
    "test:virtual-list": "vp test run tests/virtual-list.test.mjs",
    "test:tree": "vp test run tests/tree-page.test.mjs tests/tree-pagination.test.mjs",
    "test:live": "PROJECTOR_TEST_DOCKER=1 PROJECTOR_TEST_DEVCONTAINER=1 vp test run --no-file-parallelism tests/environment-live.test.mjs tests/reconcile.test.mjs tests/devcontainer-live.test.mjs tests/sigkill-live.test.mjs",
    "check": "vp run build:prepare && vp test run && vp run --cache build:app",
    "prepare": "node scripts/ensure-vite-plus-core.mjs && vp hooks enable",
    "test:gtk": "node --import @zede/vio/register tests/native-palette.gtk.mjs",
    "bench:chat": "node scripts/bench-chat/run.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "@codemirror/view": "^6.43.13",
    "@iconify-json/devicon": "^1.2.68",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/simple-icons": "^1.2.98",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@o-feod/eslint-structure-plugin": "0.1.3",
    "@o-feod/oxlint-structure-plugin": "0.1.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "@zede/vio": "0.7.1",
    "ai": "^7.0.112",
    "node-gtk": "4.1.1",
    "node-gyp": "^13.0.2",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
