{
  "name": "@projector/claude-code-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Claude Code через Anthropic Agent SDK для Projector",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291"
  },
  "engines": {
    "projector": ">=0.12.0"
  },
  "projector": {
    "apiVersion": 1,
    "server": "dist/server.cjs",
    "browser": "dist/browser.js",
    "contributes": {
      "agents": [
        {
          "id": "claude-code",
          "title": "Claude Code",
          "caption": "Запустит агента Anthropic",
          "icon": "icons/claude.svg",
          "program": "claude",
          "terminal": {
            "executable": "claude",
            "title": "Claude Code"
          },
          "defaultFeatures": [
            "widgets"
          ]
        }
      ]
    }
  }
}
